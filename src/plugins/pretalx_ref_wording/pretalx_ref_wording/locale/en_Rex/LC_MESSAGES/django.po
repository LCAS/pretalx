# --- Auto-generated overrides below ---
# Generated by scanning every English UI string in pretalx for the whole
# words "proposal(s)", "speaker(s)", "event(s)" and applying:
#   proposal(s) -> output(s), speaker(s) -> author(s), event(s) -> review round(s)
# Placeholders like %(name)s and {name} were left untouched. Review carefully
# before relying on this in production - a few strings (e.g. ones combining
# "speakers, authors, submitters") may read awkwardly and need manual tweaks.

msgid "Thanks, we (and our speakers) appreciate your feedback!"
msgstr "Thanks, we (and our authors) appreciate your feedback!"

msgid "Edit or view your proposals"
msgstr "Edit or view your outputs"

msgid "In the near future you will see a curated list of sessions we’d like to show off here. Right now we are busy reviewing proposals.<br> Check back later!"
msgstr "In the near future you will see a curated list of sessions we’d like to show off here. Right now we are busy reviewing outputs.<br> Check back later!"

msgid "This feedback is for you personally, not for all speakers in this session."
msgstr "This feedback is for you personally, not for all authors in this session."

msgid "Feedback is a valuable tool for speakers to improve their content and presentation. Even short feedback can prove valuable to a speaker! Please take the time and communicate your thoughts in a constructive way."
msgstr "Feedback is a valuable tool for authors to improve their content and presentation. Even short feedback can prove valuable to an author! Please take the time and communicate your thoughts in a constructive way."

msgid "This speaker also appears in:"
msgstr "This author also appears in:"

msgid "No speakers"
msgstr "No authors"

msgid "Congratulations, you’ve submitted your proposal! You can continue to make changes to it up to the submission deadline, and you will be notified of any changes or questions."
msgstr "Congratulations, you’ve submitted your output! You can continue to make changes to it up to the submission deadline, and you will be notified of any changes or questions."

msgid "We’re glad that you want to contribute to our event with your proposal. Let’s get started, this won’t take long."
msgstr "We’re glad that you want to contribute to our review round with your output. Let’s get started, this won’t take long."

msgid "Before we can save your proposal, we have some more questions for you."
msgstr "Before we can save your output, we have some more questions for you."

msgid "That’s it about your proposal! We now just need a way to contact you."
msgstr "That’s it about your output! We now just need a way to contact you."

msgid "To create your proposal, you need an account on this page. This not only gives us a way to contact you, it also gives you the possibility to edit your proposal or to view its current state."
msgstr "To create your output, you need an account on this page. This not only gives us a way to contact you, it also gives you the possibility to edit your output or to view its current state."

msgid "This information will be publicly displayed next to your session - you can always edit for as long as proposals are still open."
msgstr "This information will be publicly displayed next to your session - you can always edit for as long as outputs are still open."

msgid "Additional speakers"
msgstr "Additional authors"

msgid "Your proposal has been withdrawn."
msgstr "Your output has been withdrawn."

msgid "Your proposal can’t be withdrawn at this time – please contact us if you need to withdraw your proposal!"
msgstr "Your output can’t be withdrawn at this time – please contact us if you need to withdraw your output!"

msgid "This proposal has already been confirmed – we’re looking forward to seeing you!"
msgstr "This output has already been confirmed – we’re looking forward to seeing you!"

msgid "This proposal cannot be confirmed at this time – please contact us if you think this is an error."
msgstr "This output cannot be confirmed at this time – please contact us if you think this is an error."

msgid "This proposal cannot be edited at this time. Please contact the organisers if you need to make changes."
msgstr "This output cannot be edited at this time. Please contact the organisers if you need to make changes."

msgid "Speaker email"
msgstr "Author email"

msgid "Hi!\n\nI’d like to invite you to be a speaker in the session\n\n  “{proposal_title}”\n\nat {event_name}. Please follow this link to join:\n\n  {url}\n\nI’m looking forward to it!\n{inviting_speaker}"
msgstr "Hi!\n\nI’d like to invite you to be an author in the session\n\n  “{proposal_title}”\n\nat {event_name}. Please follow this link to join:\n\n  {url}\n\nI’m looking forward to it!\n{inviting_speaker}"

